{
  "$schema": "./schema.md",
  "$description": "Style dictionary for the rainbow web mark — the desktop-app alternate identity. Shared verbatim with beginner-work/web at src/renderer/tokens/rainbow-web.json. If you change anything here, update the web repo copy in the same commit (or the next one).",
  "viewBox": "0 0 200 200",
  "background": "#F5F3EF",
  "cornerRadius": 44,
  "spokes": {
    "count": 8,
    "color": "#2D5A3D",
    "strokeWidth": 1.4,
    "length": 90,
    "opacity": 0.5
  },
  "center": {
    "color": "#2D5A3D",
    "radius": 3.2
  },
  "ringStrokeWidth": 2.4,
  "rings": [
    { "name": "rose",   "radius": 12, "color": "#F9A8D4" },
    { "name": "peach",  "radius": 24, "color": "#FDBA74" },
    { "name": "amber",  "radius": 36, "color": "#FDE68A" },
    { "name": "mint",   "radius": 48, "color": "#6EE7B7" },
    { "name": "sky",    "radius": 60, "color": "#7DD3FC" },
    { "name": "indigo", "radius": 72, "color": "#A5B4FC" },
    { "name": "violet", "radius": 84, "color": "#C4B5FD" }
  ]
}
