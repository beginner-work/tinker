{
  "version": 2,
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "src/renderer",
  "installCommand": "npm ci",
  "buildCommand": "prisma generate",
  "ignoreCommand": "if [ \"$VERCEL_GIT_COMMIT_REF\" = \"main\" ] || [ \"$VERCEL_GIT_COMMIT_REF\" = \"crafting\" ]; then exit 1; else exit 0; fi",
  "rewrites": [
    { "source": "/.well-known/oauth-protected-resource", "destination": "/api/mcp-oauth?op=resource" },
    { "source": "/.well-known/oauth-protected-resource/api/mcp", "destination": "/api/mcp-oauth?op=resource" },
    { "source": "/.well-known/oauth-authorization-server", "destination": "/api/mcp-oauth?op=as" },
    { "source": "/mcp/register", "destination": "/api/mcp-oauth?op=register" },
    { "source": "/mcp/authorize", "destination": "/api/mcp-oauth?op=authorize" },
    { "source": "/mcp/token", "destination": "/api/mcp-oauth?op=token" },
    { "source": "/mcp/access", "destination": "/api/mcp-oauth?op=access" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ]
}
