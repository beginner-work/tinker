{
  "version": 2,
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "src/renderer",
  "installCommand": "npm ci",
  "buildCommand": "prisma generate",
  "ignoreCommand": "case \"$VERCEL_GIT_COMMIT_REF\" in main|crafting|cursor/*) exit 1 ;; *) exit 0 ;; esac",
  "rewrites": [
    { "source": "/.well-known/oauth-protected-resource", "destination": "/api/mcp-oauth?op=resource" },
    { "source": "/.well-known/oauth-protected-resource/api/mcp", "destination": "/api/mcp-oauth?op=resource" },
    { "source": "/.well-known/oauth-authorization-server", "destination": "/api/mcp-oauth?op=as" },
    { "source": "/mcp/register", "destination": "/api/mcp-oauth?op=register" },
    { "source": "/mcp/authorize", "destination": "/api/mcp-oauth?op=authorize" },
    { "source": "/mcp/token", "destination": "/api/mcp-oauth?op=token" },
    { "source": "/mcp/access", "destination": "/api/mcp-oauth?op=access" },
    { "source": "/api/autonomy/:key", "destination": "/api/autonomy?key=:key" },
    { "source": "/api/career/:action", "destination": "/api/career?action=:action" },
    { "source": "/api/leads/:action", "destination": "/api/leads?action=:action" },
    { "source": "/api/schedule/:action", "destination": "/api/schedule?action=:action" },
    { "source": "/api/self-thread/:action", "destination": "/api/self-thread?action=:action" },
    { "source": "/api/self-reflections/:action", "destination": "/api/self-reflections?action=:action" },
    { "source": "/api/reading-thread/:action", "destination": "/api/reading-thread?action=:action" },
    { "source": "/api/job-application/:action", "destination": "/api/job-application?action=:action" },
    { "source": "/api/sites/:site/content", "destination": "/api/content-public?site=:site" },
    { "source": "/api/sites/:site/content/:slug", "destination": "/api/content-public?site=:site&slug=:slug" },
    { "source": "/autonomy", "destination": "/autonomy/index.html" },
    { "source": "/autonomy/", "destination": "/autonomy/index.html" },
    { "source": "/career", "destination": "/career/index.html" },
    { "source": "/career/", "destination": "/career/index.html" },
    { "source": "/leads", "destination": "/leads/index.html" },
    { "source": "/leads/", "destination": "/leads/index.html" },
    { "source": "/settings", "destination": "/settings/index.html" },
    { "source": "/settings/", "destination": "/settings/index.html" },
    { "source": "/feed", "destination": "/feed/index.html" },
    { "source": "/feed/", "destination": "/feed/index.html" },
    { "source": "/repo", "destination": "/repo/index.html" },
    { "source": "/repo/", "destination": "/repo/index.html" },
    { "source": "/api/essay-feed/:action", "destination": "/api/essay-feed?action=:action" },
    { "source": "/gmail", "destination": "/api/gmail" },
    { "source": "/gmail/", "destination": "/api/gmail" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/(.*)\\.(js|css|svg|png|woff2|json)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/repo/(.*)\\.(js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, stale-while-revalidate=600"
        }
      ]
    },
    {
      "source": "/(messages-shell|messages-you|lib/stories-md)\\.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, stale-while-revalidate=600"
        }
      ]
    }
  ]
}
