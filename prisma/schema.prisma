// Web's slice of the schema. The canonical schema lives in the
// beginner repo at api/prisma/schema.prisma; this file mirrors the
// tables the web Vercel functions touch directly. Both repos point
// at the same Postgres via DATABASE_URL.

generator client {
  provider      = "prisma-client-js"
  // "rhel-openssl-3.0.x" is what Vercel's serverless runtime needs;
  // "native" lets `prisma generate` work locally on macOS/Linux dev
  // machines.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TinkerUserData {
  userId    String
  kind      String
  data      Json     @default("null")
  updatedAt DateTime @default(now()) @updatedAt

  @@id([userId, kind])
  @@index([userId])
}

// Durable MCP bearer keys. The plaintext is returned once, to the
// connector's token endpoint or to the one-time fallback on MCP access.
// keyHash is the SHA-256 hex of the full mcp_ key. revokedAt stays null
// until revoke.
model McpApiKey {
  id        String    @id @default(cuid())
  keyHash   String    @unique
  label     String
  userId    String
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
}

// Public OAuth clients for MCP. redirectUris is a JSON array of exact
// callback URLs. No client secret; PKCE S256 is required.
model McpOAuthClient {
  id           String   @id @default(cuid())
  clientId     String   @unique
  clientName   String
  redirectUris String
  createdAt    DateTime @default(now())
}

// A note published as site content. type is page_section, product,
// event, post, or link. status is draft or published. fields holds
// the structured copy for that type. noteId is the note it came from.
// draftKey is the idempotency key for a draft. The public site API
// reads published rows only. Someone else's id is not this row.
model ContentItem {
  id        String   @id @default(cuid())
  userId    String
  site      String
  type      String
  slug      String
  title     String
  body      String   @default("")
  fields    Json     @default("{}")
  status    String
  noteId    String?
  draftKey  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([site, slug])
  @@unique([userId, draftKey])
  @@index([userId])
  @@index([site, status])
}

// One-time authorization codes. codeHash is the SHA-256 hex of the code.
// usedAt is set when the code is exchanged.
model McpOAuthCode {
  id            String    @id @default(cuid())
  codeHash      String    @unique
  clientId      String
  redirectUri   String
  codeChallenge String
  resource      String
  userId        String
  label         String
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())
}

model StoryPart {
  id            String    @id @default(cuid())
  userId        String
  stageKey      String
  title         String    @default("")
  body          String    @default("")
  fields        Json      @default("{}")
  topics        Json      @default("[]")
  stack         Json      @default("[]")
  concepts      Json      @default("[]")
  status        String
  sourceKind    String
  sourceId      String?
  sourceRef     Json      @default("{}")
  sourceExcerpt String    @default("")
  sourceHash    String?
  checkVerdicts Json      @default("[]")
  checkedAt     DateTime?
  createdBy     String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
}

model StoryPartEvent {
  id     String   @id @default(cuid())
  userId String
  partId String
  actor  String
  action String
  detail Json     @default("{}")
  at     DateTime @default(now())

  @@index([userId])
  @@index([partId])
}

model Lead {
  id              String    @id @default(cuid())
  userId          String
  personName      String    @default("")
  personTitle     String    @default("")
  linkedInUrl     String    @default("")
  email           String    @default("")
  company         String    @default("")
  companyId       String?
  contactType     String    @default("other")
  queueOrder      Int       @default(0)
  targetRoleTitle String    @default("")
  postingUrl      String    @default("")
  source          String
  stage           String
  nextStep        String    @default("")
  nextStepAt      DateTime?
  notes           String    @default("")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  @@index([userId])
  @@index([userId, stage])
  @@index([companyId])
}

model TargetCompany {
  id              String   @id @default(cuid())
  userId          String
  name            String
  domain          String   @default("")
  northStar       Boolean  @default(false)
  status          String
  totalComp       Int?
  totalCompSource String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([userId])
  @@index([userId, name])
}

model LeadDraft {
  id           String   @id @default(cuid())
  userId       String
  leadId       String?
  channel      String
  subject      String   @default("")
  body         String   @default("")
  fromAddress  String   @default("")
  status       String
  storyPartIds Json     @default("[]")
  factCheck    Json     @default("{}")
  createdBy    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([userId])
  @@index([leadId])
}

model LeadEvent {
  id     String   @id @default(cuid())
  userId String
  leadId String?
  actor  String
  action String
  detail Json     @default("{}")
  at     DateTime @default(now())
  @@index([userId])
  @@index([leadId])
}

// Planned outreach touch. Never sends. Types/statuses live in the store.
model OutreachTouch {
  id          String   @id @default(cuid())
  userId      String
  companyId   String
  touchType   String
  date        DateTime
  windowStart String   @default("")
  windowEnd   String   @default("")
  leadId      String?
  status      String
  draftId     String?
  sessionId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([userId])
  @@index([userId, date])
  @@index([companyId])
  @@index([sessionId])
}

// Calendar block: company craft time or skill (productArea+concept+curriculumRef).
model OutreachSession {
  id            String   @id @default(cuid())
  userId        String
  type          String
  title         String
  startsAt      DateTime
  endsAt        DateTime
  productArea   String   @default("")
  concept       String   @default("")
  curriculumRef String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([userId])
  @@index([userId, startsAt])
}
