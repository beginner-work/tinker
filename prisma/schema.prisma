// tinker owns its own database. As of the PlanetScale migration this
// repo no longer shares a Postgres with the beginner repo — each repo
// owns its own database. `TinkerUserData` is the one table tinker's web
// Vercel functions touch, and it now lives in tinker's dedicated
// PlanetScale for Postgres database, reached via PLANETSCALE_URL.

generator client {
  provider      = "prisma-client-js"
  // "rhel-openssl-3.0.x" is what Vercel's serverless runtime needs;
  // "native" lets `prisma generate` work locally on macOS/Linux dev
  // machines.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // PlanetScale for Postgres connection string. Set in the tinker Vercel
  // project (production + preview) and in local .env. The old shared-Neon
  // DATABASE_URL is retired here.
  url      = env("PLANETSCALE_URL")
}

model TinkerUserData {
  userId    String
  kind      String
  data      Json     @default("null")
  updatedAt DateTime @default(now()) @updatedAt

  @@id([userId, kind])
  @@index([userId])
}
