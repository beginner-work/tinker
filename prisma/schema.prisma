// Web's slice of the schema. The canonical schema lives in the
// beginner repo at api/prisma/schema.prisma; this file mirrors the
// tables the web Vercel functions touch directly. Both repos point
// at the same Postgres via DATABASE_URL.

generator client {
  provider      = "prisma-client-js"
  // "rhel-openssl-3.0.x" is what Vercel's serverless runtime needs;
  // "native" lets `prisma generate` work locally on macOS/Linux dev
  // machines.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TinkerUserData {
  userId    String
  kind      String
  data      Json     @default("null")
  updatedAt DateTime @default(now()) @updatedAt

  @@id([userId, kind])
  @@index([userId])
}

// Durable MCP bearer keys. The plaintext is returned once, to the
// connector's token endpoint or to the one-time fallback on MCP access.
// keyHash is the SHA-256 hex of the full mcp_ key. revokedAt stays null
// until revoke.
model McpApiKey {
  id        String    @id @default(cuid())
  keyHash   String    @unique
  label     String
  userId    String
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
}

// Public OAuth clients for MCP. redirectUris is a JSON array of exact
// callback URLs. No client secret; PKCE S256 is required.
model McpOAuthClient {
  id           String   @id @default(cuid())
  clientId     String   @unique
  clientName   String
  redirectUris String
  createdAt    DateTime @default(now())
}

// A note published as site content. type is page_section, product,
// event, post, or link. status is draft or published. fields holds
// the structured copy for that type. noteId is the note it came from.
// draftKey is the idempotency key for a draft. The public site API
// reads published rows only. Someone else's id is not this row.
model ContentItem {
  id        String   @id @default(cuid())
  userId    String
  site      String
  type      String
  slug      String
  title     String
  body      String   @default("")
  fields    Json     @default("{}")
  status    String
  noteId    String?
  draftKey  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([site, slug])
  @@unique([userId, draftKey])
  @@index([userId])
  @@index([site, status])
}

// One-time authorization codes. codeHash is the SHA-256 hex of the code.
// usedAt is set when the code is exchanged.
model McpOAuthCode {
  id            String    @id @default(cuid())
  codeHash      String    @unique
  clientId      String
  redirectUri   String
  codeChallenge String
  resource      String
  userId        String
  label         String
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())
}

model Lead {
  id              String    @id @default(cuid())
  userId          String
  personName      String    @default("")
  personTitle     String    @default("")
  linkedInUrl     String    @default("")
  githubUrl       String    @default("")
  email           String    @default("")
  company         String    @default("")
  companyId       String?
  contactType     String    @default("other")
  queueOrder      Int       @default(0)
  targetRoleTitle String    @default("")
  postingUrl      String    @default("")
  source          String
  stage           String
  nextStep        String    @default("")
  nextStepAt      DateTime?
  notes           String    @default("")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  @@index([userId])
  @@index([userId, stage])
  @@index([companyId])
}

model LeadDraft {
  id                   String    @id @default(cuid())
  userId               String
  leadId               String?
  channel              String
  subject              String    @default("")
  body                 String    @default("")
  fromAddress          String    @default("")
  status               String
  factCheck            Json      @default("{}")
  createdBy            String
  // "tinker_answer" = auto-built from This is everything answers.
  // Empty/unknown = treat as hand-edited (Clair/owner); never overwrite.
  origin               String    @default("")
  approvedAt           DateTime?
  approvedText         String    @default("")
  approvedPersonName   String    @default("")
  approvedCompanyName  String    @default("")
  sentAt               DateTime?
  externalMessageId    String    @default("")
  failedReason         String    @default("")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  @@index([userId])
  @@index([leadId])
}

model LeadEvent {
  id     String   @id @default(cuid())
  userId String
  leadId String?
  actor  String
  action String
  detail Json     @default("{}")
  at     DateTime @default(now())
  @@index([userId])
  @@index([leadId])
}

model TargetCompany {
  id              String   @id @default(cuid())
  userId          String
  name            String
  domain          String   @default("")
  northStar       Boolean  @default(false)
  priority        Int      @default(100)
  tier            String   @default("other")
  notes           String   @default("")
  research        String   @default("")
  status          String
  totalComp       Int?
  totalCompSource String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([userId])
  @@index([userId, name])
}

model OutreachTouch {
  id          String   @id @default(cuid())
  userId      String
  companyId   String
  touchType   String
  date        DateTime
  windowStart String   @default("")
  windowEnd   String   @default("")
  leadId      String?
  status      String
  draftId     String?
  sessionId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([userId])
  @@index([userId, date])
  @@index([companyId])
  @@index([sessionId])
}

model OutreachSession {
  id            String   @id @default(cuid())
  userId        String
  type          String
  title         String
  startsAt      DateTime
  endsAt        DateTime
  productArea   String   @default("")
  concept       String   @default("")
  curriculumRef String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([userId])
  @@index([userId, startsAt])
}

// Cached TTS audio for the private /feed reader. Keyed by essay + voice
// so swapping ELEVENLABS_VOICE_ID does not serve stale audio. Does not
// touch the essays blob / essay data model.
model EssayFeedAudioCache {
  userId       String
  essayId      String
  voiceId      String
  audioBase64  String
  contentType  String   @default("audio/mpeg")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@id([userId, essayId, voiceId])
  @@index([userId])
}

// First-party product analytics. Never stores draft text, titles, or
// keystroke contents — only event names, ids, lengths/buckets, and
// first-touch attribution (utm_*/ref/referrer host).
model AnalyticsEvent {
  id           String   @id @default(cuid())
  name         String
  ts           DateTime
  receivedAt   DateTime @default(now())
  anonymousId  String
  userId       String   @default("")
  sessionId    String
  deviceType   String   @default("desktop")
  viewportW    Int      @default(0)
  viewportH    Int      @default(0)
  path         String   @default("/")
  appVersion   String   @default("")
  utmSource    String   @default("")
  utmMedium    String   @default("")
  utmCampaign  String   @default("")
  utmContent   String   @default("")
  ref          String   @default("")
  referrerHost String   @default("")
  props        Json     @default("{}")

  @@index([name, ts])
  @@index([ts])
  @@index([anonymousId, ts])
  @@index([userId, ts])
  @@index([sessionId])
}

// Maps anonymous browser ids to signed-in users and locks first-touch
// attribution so a utm-tagged landing survives through signup.
model AnalyticsIdentity {
  anonymousId  String   @id
  userId       String   @default("")
  utmSource    String   @default("")
  utmMedium    String   @default("")
  utmCampaign  String   @default("")
  utmContent   String   @default("")
  ref          String   @default("")
  referrerHost String   @default("")
  firstSeenAt  DateTime @default(now())
  linkedAt     DateTime?
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

// Compact keystroke chunks. packed is [[ms, cat, count?], ...] — never
// key values or text. Raw rows kept ~90 days, then rolled into
// AnalyticsWritingSession aggregates.
model AnalyticsKeystrokeChunk {
  id          String   @id @default(cuid())
  sessionId   String
  anonymousId String
  userId      String   @default("")
  startedAt   DateTime
  chunkIndex  Int      @default(0)
  packed      Json
  createdAt   DateTime @default(now())

  @@index([sessionId, chunkIndex])
  @@index([createdAt])
  @@index([anonymousId])
}

// Per writing-session aggregates derived from keystroke chunks + CTA
// events. Survives after raw chunks are purged at 90 days.
model AnalyticsWritingSession {
  sessionId              String   @id
  anonymousId            String
  userId                 String   @default("")
  startedAt              DateTime
  endedAt                DateTime?
  keyCount               Int      @default(0)
  keysPerMinute          Float    @default(0)
  activeTypingMs         Int      @default(0)
  pausesOver2s           Int      @default(0)
  pausesOver10s          Int      @default(0)
  burstCount             Int      @default(0)
  avgBurstLength         Float    @default(0)
  backspaceDeleteRatio   Float    @default(0)
  pasteCount             Int      @default(0)
  cutCount               Int      @default(0)
  timeToFirstWordMs      Int?
  timeFirstWordToDoneMs  Int?
  timeline               Json     @default("[]")
  rolledUpAt             DateTime?
  updatedAt              DateTime @updatedAt

  @@index([userId])
  @@index([startedAt])
  @@index([anonymousId])
}

