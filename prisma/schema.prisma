// Web's slice of the schema. The canonical schema lives in the
// beginner repo at api/prisma/schema.prisma; this file mirrors the
// tables the web Vercel functions touch directly. Both repos point
// at the same Postgres via DATABASE_URL.

generator client {
  provider      = "prisma-client-js"
  // "rhel-openssl-3.0.x" is what Vercel's serverless runtime needs;
  // "native" lets `prisma generate` work locally on macOS/Linux dev
  // machines.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TinkerUserData {
  userId    String
  kind      String
  data      Json     @default("null")
  updatedAt DateTime @default(now()) @updatedAt

  @@id([userId, kind])
  @@index([userId])
}

// Durable MCP bearer keys. The plaintext is returned once, to the
// connector's token endpoint or to the one-time fallback on MCP access.
// keyHash is the SHA-256 hex of the full mcp_ key. revokedAt stays null
// until revoke.
model McpApiKey {
  id        String    @id @default(cuid())
  keyHash   String    @unique
  label     String
  userId    String
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
}

// Public OAuth clients for MCP. redirectUris is a JSON array of exact
// callback URLs. No client secret; PKCE S256 is required.
model McpOAuthClient {
  id           String   @id @default(cuid())
  clientId     String   @unique
  clientName   String
  redirectUris String
  createdAt    DateTime @default(now())
}

// A note published as site content. type is page_section, product,
// event, post, or link. status is draft or published. fields holds
// the structured copy for that type. noteId is the note it came from.
// draftKey is the idempotency key for a draft. The public site API
// reads published rows only. Someone else's id is not this row.
model ContentItem {
  id        String   @id @default(cuid())
  userId    String
  site      String
  type      String
  slug      String
  title     String
  body      String   @default("")
  fields    Json     @default("{}")
  status    String
  noteId    String?
  draftKey  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([site, slug])
  @@unique([userId, draftKey])
  @@index([userId])
  @@index([site, status])
}

// One-time authorization codes. codeHash is the SHA-256 hex of the code.
// usedAt is set when the code is exchanged.
model McpOAuthCode {
  id            String    @id @default(cuid())
  codeHash      String    @unique
  clientId      String
  redirectUri   String
  codeChallenge String
  resource      String
  userId        String
  label         String
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())
}
// GTM outbox. Event threadId is null only for a contact create.
model MessagingContact {
  id           String   @id @default(cuid())
  userId       String
  email        String
  name         String   @default("")
  company      String   @default("")
  title        String   @default("")
  source       String
  tags         Json     @default("[]")
  doNotContact Boolean  @default(false)
  notes        String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@unique([userId, email])
  @@index([userId])
}
model MessagingThread {
  id            String    @id @default(cuid())
  userId        String
  contactId     String
  channel       String
  subject       String    @default("")
  status        String
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  @@index([userId])
  @@index([contactId])
}
model MessagingMessage {
  id                String    @id @default(cuid())
  userId            String
  threadId          String
  direction         String
  status            String
  subject           String    @default("")
  body              String    @default("")
  fromAddr          String    @default("")
  toAddr            String    @default("")
  cc                Json      @default("[]")
  scheduledAt       DateTime?
  approvedAt        DateTime?
  approvedBy        String?
  sentAt            DateTime?
  providerMessageId String?
  inReplyTo         String?
  draftKey          String?
  createdBy         String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  @@unique([userId, draftKey])
  @@index([userId])
  @@index([threadId])
}
model MessagingEvent {
  id        String   @id @default(cuid())
  userId    String
  threadId  String?
  messageId String?
  actor     String
  action    String
  detail    Json     @default("{}")
  at        DateTime @default(now())
  @@index([userId])
  @@index([threadId])
}
