// Web's slice of the schema. The canonical schema lives in the
// beginner repo at api/prisma/schema.prisma; this file mirrors the
// tables the web Vercel functions touch directly. Both repos point
// at the same Postgres via DATABASE_URL.

generator client {
  provider      = "prisma-client-js"
  // "rhel-openssl-3.0.x" is what Vercel's serverless runtime needs;
  // "native" lets `prisma generate` work locally on macOS/Linux dev
  // machines.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TinkerUserData {
  userId    String
  kind      String
  data      Json     @default("null")
  updatedAt DateTime @default(now()) @updatedAt

  @@id([userId, kind])
  @@index([userId])
}

// Durable MCP bearer keys. The plaintext is returned once, to the
// connector's token endpoint or to the one-time fallback on MCP access.
// keyHash is the SHA-256 hex of the full mcp_ key. revokedAt stays null
// until revoke.
model McpApiKey {
  id        String    @id @default(cuid())
  keyHash   String    @unique
  label     String
  userId    String
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
}

// Public OAuth clients for MCP. redirectUris is a JSON array of exact
// callback URLs. No client secret; PKCE S256 is required.
model McpOAuthClient {
  id           String   @id @default(cuid())
  clientId     String   @unique
  clientName   String
  redirectUris String
  createdAt    DateTime @default(now())
}

// One-time authorization codes. codeHash is the SHA-256 hex of the code.
// usedAt is set when the code is exchanged.
model McpOAuthCode {
  id            String    @id @default(cuid())
  codeHash      String    @unique
  clientId      String
  redirectUri   String
  codeChallenge String
  resource      String
  userId        String
  label         String
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())
}

// LinkedIn posts and DMs Tyler keeps in tinker. kind is post or dm.
// status is draft, approved, scheduled, or posted. scheduledAt is a
// stored date and time; nothing here posts to LinkedIn.
model LinkedInDraft {
  id          String    @id @default(cuid())
  userId      String
  body        String
  notes       String    @default("")
  kind        String
  status      String
  scheduledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
}
