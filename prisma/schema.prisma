// Web's slice of the schema. The canonical schema lives in the
// beginner repo at api/prisma/schema.prisma; this file mirrors the
// tables the web Vercel functions touch directly. Both repos point
// at the same Postgres via DATABASE_URL.

generator client {
  provider      = "prisma-client-js"
  // "rhel-openssl-3.0.x" is what Vercel's serverless runtime needs;
  // "native" lets `prisma generate` work locally on macOS/Linux dev
  // machines.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TinkerUserData {
  userId    String
  kind      String
  data      Json     @default("null")
  updatedAt DateTime @default(now()) @updatedAt

  @@id([userId, kind])
  @@index([userId])
}

// Durable MCP bearer keys. The plaintext is returned once, to the
// connector's token endpoint or to the one-time fallback on MCP access.
// keyHash is the SHA-256 hex of the full mcp_ key. revokedAt stays null
// until revoke.
model McpApiKey {
  id        String    @id @default(cuid())
  keyHash   String    @unique
  label     String
  userId    String
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
}

// Public OAuth clients for MCP. redirectUris is a JSON array of exact
// callback URLs. No client secret; PKCE S256 is required.
model McpOAuthClient {
  id           String   @id @default(cuid())
  clientId     String   @unique
  clientName   String
  redirectUris String
  createdAt    DateTime @default(now())
}

// A note published as site content. type is page_section, product,
// event, post, or link. status is draft or published. fields holds
// the structured copy for that type. noteId is the note it came from.
// draftKey is the idempotency key for a draft. The public site API
// reads published rows only. Someone else's id is not this row.
model ContentItem {
  id        String   @id @default(cuid())
  userId    String
  site      String
  type      String
  slug      String
  title     String
  body      String   @default("")
  fields    Json     @default("{}")
  status    String
  noteId    String?
  draftKey  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([site, slug])
  @@unique([userId, draftKey])
  @@index([userId])
  @@index([site, status])
}

// One-time authorization codes. codeHash is the SHA-256 hex of the code.
// usedAt is set when the code is exchanged.
model McpOAuthCode {
  id            String    @id @default(cuid())
  codeHash      String    @unique
  clientId      String
  redirectUri   String
  codeChallenge String
  resource      String
  userId        String
  label         String
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())
}

model SellingPart {
  id            String    @id @default(cuid())
  userId        String
  stageKey      String
  title         String    @default("")
  body          String    @default("")
  fields        Json      @default("{}")
  topics        Json      @default("[]")
  status        String
  sourceKind    String
  sourceId      String?
  sourceExcerpt String    @default("")
  sourceHash    String?
  checkVerdicts Json      @default("[]")
  checkedAt     DateTime?
  draftKey      String?
  createdBy     String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([userId, draftKey])
  @@index([userId])
}

model SellingPartEvent {
  id     String   @id @default(cuid())
  userId String
  partId String
  actor  String
  action String
  detail Json     @default("{}")
  at     DateTime @default(now())

  @@index([userId])
  @@index([partId])
}
