# Autonomy settings live in Upstash Redis, one hash per signed-in user.
# GET uses KV_REST_API_URL with KV_REST_API_READ_ONLY_TOKEN.
# PUT uses KV_REST_API_URL with KV_REST_API_TOKEN. If that write pair
# is unset, PUT returns 503 and saves nothing.
# The app does not read KV_URL or REDIS_URL. Leave these empty in the
# repo. Do not commit a URL or a token.
#
# Content items use the existing DATABASE_URL (the same Postgres as MCP
# keys). There is no new store and no new key. Do not commit DATABASE_URL.
#
# Outbound MCP Connections (Notion, …) encrypt access/refresh tokens with
# AES-256-GCM. Prefer TINKER_SECRETS_KEY (any long random string; hashed to
# 32 bytes). Falls back to STYTCH_SECRET, then a local-dev default.
# Same key as reflection webhook secrets and Notion essay OAuth tokens.
# Do not commit a production value.
# TINKER_SECRETS_KEY=
#
# Notion public-integration OAuth (Connect Notion → Essays database).
# Create a public integration in Notion with redirect URI matching
# NOTION_OAUTH_REDIRECT_URI. Capabilities: Read content, Insert content,
# Update content. Do not commit secrets.
# NOTION_OAUTH_CLIENT_ID=
# NOTION_OAUTH_CLIENT_SECRET=
# NOTION_OAUTH_REDIRECT_URI=https://tinker.beginner.work/api/notion-oauth?action=callback
#
# Private /feed voice playback (ElevenLabs). Both must be set for the
# play button to appear. Audio is generated on first play per essay and
# cached by (essay id, voice id). Do not commit real keys.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# Optional model override (defaults to eleven_multilingual_v2):
# ELEVENLABS_MODEL_ID=
#
# Speech-to-text (POST /api/transcribe). Uses ELEVENLABS_API_KEY above.
# TINKER_SERVICE_TOKEN is the shared secret for server-to-server callers
# (lindowlabs.dev proxies here; never put this token or the ElevenLabs
# key in browser JS). Optional STT model override (defaults to scribe_v2):
# TINKER_SERVICE_TOKEN=
# ELEVENLABS_STT_MODEL=scribe_v2
#
# Grounded ask + TTS (POST /api/ask). Same TINKER_SERVICE_TOKEN auth as
# /api/transcribe. Answers with Anthropic Claude; speaks with ElevenLabs
# (default voice ogwqBH5bbF03DSbNiRNN = Savvy, a stock premade;
# overridable per source — never use a personal/cloned voice).
# ANTHROPIC_API_KEY is already used elsewhere on this deploy.
# ASK_MODEL is optional (defaults to Claude Haiku 4.5):
# ANTHROPIC_API_KEY=
# ASK_MODEL=claude-haiku-4-5-20251001
#
# Owner-only /metrics gate. Comma-separated Stytch user ids. Prefer
# METRICS_OWNER_ALLOWLIST; if empty, falls back to LEADS_OWNER_ALLOWLIST
# (already set on Vercel for Tyler). Both empty = nobody (fail closed).
# Do not commit real ids.
# METRICS_OWNER_ALLOWLIST=
# LEADS_OWNER_ALLOWLIST=
#
# Build-time writing summary for lindowlabs.dev. Set the same secret on
# tinker (Vercel Production + Preview) and in the lindowlabs.dev build
# env. GET /api/writing-summary requires Authorization: Bearer <token>.
# WRITING_SUMMARY_TOKEN=

# Vercel Blob — Tinker source of truth for exercise files. When unset,
# exercise seed falls back to the checked-in snapshot JSON.
# BLOB_READ_WRITE_TOKEN=
# Access mode for put/get. Default public (tinker-exercises store is public).
# Set to private only if the Blob store itself is private.
# BLOB_ACCESS=public
#
# Cursor Cloud Agents API — unused by Tinker (in-flight tracking moved to Notion).
# Harmless if set; leave unset. Do not remove from deploys that still have it.
# CURSOR_API_KEY=

KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
