# Autonomy toggles live in Vercel Edge Config. Preview and production
# use separate stores. Vercel sets EDGE_CONFIG when a store is connected
# to that project environment. Leave these empty in the repo.

EDGE_CONFIG=
EDGE_CONFIG_ID=
VERCEL_TEAM_ID=
# Sensitive. Write token for PATCH /v1/edge-config/{id}/items.
EDGE_CONFIG_WRITE_TOKEN=
# Comma-separated Stytch user id or email, optional :short-name.
AUTONOMY_ALLOWLIST=
