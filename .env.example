# Autonomy settings live in Upstash Redis, one hash per signed-in user.
# The Vercel Marketplace may inject either pair. The app uses the first
# pair that is fully set. Leave these empty in the repo. Do not commit
# a URL or a token.

KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
