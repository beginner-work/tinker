{
  "title": "Checkout SLO",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "type": "timeseries",
      "title": "Success ratio (5m recording rule)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "job:http_success:ratio_rate5m",
          "legendFormat": "success ratio"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Bounded series (app)",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "app_series_count",
          "legendFormat": "series"
        }
      ]
    }
  ]
}
