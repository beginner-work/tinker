{
  "name": "tinker-browser",
  "version": "0.1.2",
  "description": "tinker — a quiet place to be on the web",
  "main": "src/main/main.js",
  "desktopName": "tinker.desktop",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "web": "node src/web/server.js",
    "lint": "eslint src/",
    "test": "node --test tests/*.test.js",
    "test:e2e:mobile": "node --test tests/messages-mobile-nav.e2e.js",
    "check:em-dash": "node scripts/check-em-dash.js",
    "check:unit-glob": "node scripts/check-unit-glob.js",
    "check": "node scripts/check.js",

    "debug:preview": "node scripts/browserbase-debug.js",
    "preview:url": "node scripts/preview-bootstrap-url.js",
    "eval:product-spec": "node .claude/skills/product-spec/evals/run-evals.mjs",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy"
  },
  "keywords": [
    "browser",
    "electron",
    "expo",
    "tinker"
  ],
  "author": "tinker",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.15.2",
    "eslint": "^9.0.0",
    "prisma": "^5.22.0"
  }
}
