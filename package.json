{
  "name": "tinker-browser",
  "version": "0.1.1",
  "description": "tinker — a quiet place to be on the web",
  "main": "src/main/main.js",
  "desktopName": "tinker.desktop",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "web": "node src/web/server.js",
    "lint": "eslint src/",
    "test": "node --test tests/*.test.js",
    "debug:preview": "node scripts/browserbase-debug.js",
    "preview:url": "node scripts/preview-bootstrap-url.js",
    "eval:product-spec": "node .claude/skills/product-spec/evals/run-evals.mjs",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "mobile:sync": "cap sync",
    "mobile:add:ios": "cap add ios",
    "mobile:add:android": "cap add android",
    "mobile:open:ios": "cap open ios",
    "mobile:open:android": "cap open android",
    "mobile:run:ios": "cap run ios",
    "mobile:run:android": "cap run android"
  },
  "keywords": [
    "browser",
    "electron",
    "capacitor",
    "tinker"
  ],
  "author": "tinker",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "@capacitor/android": "^6.2.0",
    "@capacitor/browser": "^6.0.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/ios": "^6.2.0",
    "@capacitor/preferences": "^6.0.0",
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "electron": "^33.0.0",
    "electron-builder": "^26.15.2",
    "eslint": "^9.0.0",
    "prisma": "^5.22.0"
  }
}
