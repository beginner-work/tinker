{
  "name": "tinker",
  "version": "0.1.29",
  "description": "tinker — a quiet writing surface on the desktop",
  "main": "src/main/main.js",
  "desktopName": "tinker.desktop",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "web": "node src/web/server.js",
    "lint": "eslint src/",
    "test": "node --test tests/*.test.js",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "test:e2e:mobile": "node --test tests/messages-mobile-nav.e2e.js",
    "debug:preview": "node scripts/browserbase-debug.js",
    "preview:url": "node scripts/preview-bootstrap-url.js",
    "eval:product-spec": "node .claude/skills/product-spec/evals/run-evals.mjs",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "build:editor": "node scripts/build-repo-cm-editor.mjs",
    "seed:exercises-blob": "node scripts/seed-exercises-to-blob.js"
  },
  "keywords": [
    "electron",
    "tinker",
    "writing"
  ],
  "author": "tinker",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.2",
    "dompurify": "^3.4.16",
    "isomorphic-dompurify": "^2.36.0",
    "markdown-it": "^14.3.2"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "@playwright/test": "^1.49.1",
    "electron": "^33.0.0",
    "electron-builder": "^26.15.2",
    "eslint": "^9.0.0",
    "playwright": "^1.49.1",
    "prisma": "^5.22.0"
  }
}
